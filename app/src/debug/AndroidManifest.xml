<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
            compose-ui-tooling (debug only) declares PreviewActivity as exported so Android Studio can launch
            previews on a device. Orange Box doesn't need that, and an exported debug activity lets any app
            start arbitrary composables, so keep it internal.
        -->
        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            android:exported="false"
            tools:replace="android:exported" />

        <!-- Debug only: share exported trips / connection logs (DebugExports). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.debugexports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/debug_export_paths" />
        </provider>
    </application>
</manifest>
