# Example settings for running the server outside local/ci/sandbox.
# Copy to .env (git-ignored) and fill in; never commit real values.
ENV=production
PORT=8080
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/orangebox?sslmode=require
JWT_PRIVATE_KEY=
JWT_KEY_ID=
# Base64 of at least 32 random bytes: openssl rand -base64 32
SYNC_TOKEN_KEY=
# Required outside local/ci/sandbox. Names this deployment of the database
# in sync tokens and cursors (with the cluster's system_identifier).
# CHANGE IT AFTER EVERY RESTORE, PITR OR BRANCH RESET (never reuse a value):
# clients then get sync_window_expired/deployment_changed and re-upload
# the trips the restore lost. Restart all instances at once (no rolling
# deploy). See README "Restoring the database".
SYNC_DEPLOYMENT_ID=prod-2026-10-25
# What sync tokens bind: cluster_and_deployment_id (default; the role must
# be allowed to run pg_control_system()) or deployment_id_only. Same value
# on every instance.
#SYNC_IDENTITY_SOURCE=cluster_and_deployment_id
