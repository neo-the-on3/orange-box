    <string name="settings_petrol_blend">Petrol blend</string>
    <string name="settings_petrol_blend_summary">The ethanol in your petrol, for the fuel estimate. Most pumps in India sell E20.</string>
    <string name="settings_auto_show">Show dashboard automatically</string>
    <string name="settings_auto_show_summary">Opens the dashboard when your car connects, and wakes the screen. Warning: it then shows over the lock screen, so your live driving data is visible without unlocking. Unlocking is still needed to leave it.</string>
    <string name="settings_full_screen_needed">Full-screen notifications are off</string>
    <string name="settings_full_screen_needed_summary">Without them the dashboard can\'t open by itself while Orange Box is in the background; you get a notification instead.</string>
