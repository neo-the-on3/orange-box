# Normalise line endings: LF everywhere by default
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix scripts must stay LF
gradlew text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
*.p12 binary
*.so binary
*.zip binary

# Linguist hints
docs/** linguist-documentation
gradlew linguist-generated
gradlew.bat linguist-generated
gradle/wrapper/** linguist-vendored
**/schemas/**/*.json linguist-generated
